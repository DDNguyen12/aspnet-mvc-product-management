@model QLBanHang_New.Models.Cart

@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    var list = Model?.CartItems ?? new List<QLBanHang_New.Models.CartItem>();
    var total = list.Sum(x => x.Quantity * (x.Product?.Price ?? 0));
}

<div class="container mt-4">

    <h2 class="fw-bold">💳 Thanh toán</h2>

    <div class="card p-4 shadow-sm mt-3">

        <h4>
            Tổng tiền:
            <span class="text-danger">
                @String.Format("{0:N0}", total) VND
            </span>
        </h4>

        <form method="post" class="mt-3">

            @Html.AntiForgeryToken()

            <!-- COD -->
            <div class="form-check">
                <input class="form-check-input"
                       type="radio"
                       name="paymentMethod"
                       value="COD"
                       id="codOption"
                       checked />

                <label class="form-check-label fw-semibold">
                    💵 Thanh toán khi nhận hàng (COD)
                </label>
            </div>

            <!-- QR -->
            <div class="form-check mt-2">
                <input class="form-check-input"
                       type="radio"
                       name="paymentMethod"
                       value="QR"
                       id="qrOption" />

                <label class="form-check-label fw-semibold">
                    📱 Thanh toán bằng QR
                </label>
            </div>

            <!-- QR BOX -->
            <div id="qrBox"
                 class="mt-3 text-center"
                 style="display:none;">

                <p class="text-muted">Quét mã để thanh toán:</p>

                <img id="qrImg"
                     src=""
                     style="width:200px;border-radius:10px;border:1px solid #ccc;" />

                <p class="text-success mt-2">
                    Sau khi quét, bấm xác nhận bên dưới
                </p>

            </div>

            <!-- BUTTON -->
            <button class="btn btn-success mt-4 px-4 w-100">
                ✅ Xác nhận thanh toán
            </button>

        </form>

    </div>

</div>

<script>
    const qrOption = document.getElementById("qrOption");
    const codOption = document.getElementById("codOption");
    const qrBox = document.getElementById("qrBox");
    const qrImg = document.getElementById("qrImg");

    // 👉 Khi chọn QR
    qrOption.addEventListener("change", function () {

        fetch('/Cart/GenerateQR')
            .then(res => res.json())
            .then(data => {
                qrImg.src = data.url;
                qrBox.style.display = "block";
            });

    });

    // 👉 Khi chọn COD → ẩn QR
    codOption.addEventListener("change", function () {
        qrBox.style.display = "none";
        qrImg.src = "";
    });
</script>