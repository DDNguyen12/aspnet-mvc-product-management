@using Microsoft.AspNetCore.Http

@{
    var user = Context.Session.GetString("User");
    var roleStr = Context.Session.GetString("Role");

    int role = 999;
    if (!string.IsNullOrEmpty(roleStr))
    {
        int.TryParse(roleStr, out role);
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QLBanHang</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- 🔥 FIX LAYOUT -->
    <style>
        html, body {
            height: 100%;
            margin: 0;
        }

        body {
            display: flex;
            flex-direction: column;
            background: #f5f5f5;
        }

        /* NAVBAR DÍNH TRÊN */
        .navbar {
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        /* CONTENT CO GIÃN */
        .main-content {
            flex: 1;
        }

        /* FOOTER LUÔN Ở DƯỚI */
        footer {
            background: #fff;
            border-top: 1px solid #ddd;
        }
    </style>

</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow">
        <div class="container">

            <!-- LOGO -->
            <a class="navbar-brand fw-bold" href="/">🛒 BanHang ND</a>

            <!-- TOGGLE -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- MENU -->
            <div class="collapse navbar-collapse" id="menu">

                <!-- LEFT -->
                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link text-warning fw-bold" href="/Product">SẢN PHẨM</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-warning fw-bold" href="/Cart">GIỎ HÀNG</a>
                    </li>

                    @if (role <= 2)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" href="/Admin">
                                ⚙ QUẢN LÝ SẢN PHẨM
                            </a>
                        </li>
                    }

                    @if (role <= 3)
                    {
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-bold" href="/Order">
                                📦 QUẢN LÝ ĐƠN HÀNG
                            </a>
                        </li>
                    }

                </ul>

                <!-- RIGHT -->
                <ul class="navbar-nav">

                    @if (string.IsNullOrEmpty(user))
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="/Auth/Login">ĐĂNG NHẬP</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/Auth/Register">ĐĂNG KÝ</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <span class="nav-link text-info">
                                👋 @user
                            </span>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-danger" href="/Auth/Logout">
                                ĐĂNG XUẤT
                            </a>
                        </li>
                    }

                </ul>

            </div>
        </div>
    </nav>

    <!-- CONTENT -->
    <div class="main-content container mt-4">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="text-center p-3">
        <p class="mb-0">
            © 2024 - QLBanHang - Đinh Nguyễn Nguyên |
            Gmail: Nguyen204apl@gmail.com |
            SDT: 0983547037
        </p>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

</body>
</html>