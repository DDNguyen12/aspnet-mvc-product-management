@using Microsoft.AspNetCore.Http

@{
    var user = Context.Session.GetString("User") ?? "Guest";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin - QLBanHang</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body style="background:#f5f5f5;">

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-black shadow">
        <div class="container">

            <!-- LOGO -->
            <a class="navbar-brand fw-bold" href="/Admin">
                ⚙ ADMIN PANEL
            </a>

            <!-- TOGGLE MOBILE -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminMenu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- MENU -->
            <div class="collapse navbar-collapse" id="adminMenu">

                <!-- LEFT -->
                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link" href="/Admin">📦 Sản phẩm</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Order">📋 Đơn hàng</a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" href="/Admin/ThongKe">📊 Thống kê</a>
                    </li>

                </ul>

                <!-- RIGHT -->
                <ul class="navbar-nav">

                    <li class="nav-item">
                        <span class="nav-link text-info">
                            👤 @user
                        </span>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link text-danger" href="/Auth/Logout">
                            Đăng xuất
                        </a>
                    </li>

                </ul>

            </div>
        </div>
    </nav>

    <!-- CONTENT -->
    <div class="container mt-4">
        @RenderBody()
    </div>

    <!-- FOOTER -->
    <footer class="text-center mt-5 p-3 bg-white border-top">
        <p class="mb-0">© 2026 - Admin Panel</p>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>